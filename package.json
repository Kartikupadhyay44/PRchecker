{
  "name": "mergememo-ai-workspace",
  "version": "1.0.0",
  "description": "MergeMemo AI — GitHub PR Intelligence & Documentation Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "test": "npm run test --workspace=server",
    "start": "node server/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
