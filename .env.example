# Server Configuration
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/mergememo

# AI Integration (Optional - Falls back to deterministic grounded analysis engine if empty)
OPENAI_API_KEY=

# GitHub API Token (Optional - Raises rate limit from 60/hr to 5,000/hr)
GITHUB_TOKEN=

# Email Dispatch (Optional - Simulates email dispatch if empty)
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@mergememo.ai

# Client URL
CLIENT_URL=http://localhost:3000

# Headless Chrome path (Defaults to macOS Google Chrome if installed)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
